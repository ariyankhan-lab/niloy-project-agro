{
  "name": "farmlife-erp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:deployment && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/generate-db-types.mjs",
    "dev:backend": "node scripts/local-auth-stack.mjs",
    "dev:backend:stop": "node scripts/local-auth-stack.mjs stop",
    "dev:gateway": "node scripts/local-auth-gateway.mjs",
    "dev:create-user": "node scripts/create-local-user.mjs",
    "test:live": "node scripts/test-live-auth.mjs",
    "test:live:browser": "node scripts/test-live-browser.mjs",
    "preview:capture": "node scripts/capture-preview.mjs",
    "preview:offline": "node scripts/build-offline-preview.mjs",
    "test:deployment": "node scripts/validate-hosted-env.test.mjs",
    "check:netlify": "node scripts/validate-hosted-env.mjs && npm run check",
    "build:netlify-package": "node scripts/build-netlify-package.mjs",
    "test:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.5.11",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
